{
  "name": "arr-ops",
  "version": "0.1.0",
  "private": true,
  "main": "out/main/index.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "dist:win": "npm run build && electron-builder --win portable --x64 && npm run build:cli-wrapper",
    "build:cli-wrapper": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-cli-wrapper.ps1",
    "lint": "tsc --noEmit",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "serve:renderer": "vite src/renderer --host 127.0.0.1 --port 4173",
    "start": "electron-vite preview",
    "cli": "electron out/main/index.cjs --cli"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.12",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "electron-store": "^10.0.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.32",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.5.2",
    "autoprefixer": "^10.4.21",
    "electron": "^44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "happy-dom": "^20.10.6",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.12"
  },
  "build": {
    "appId": "local.arr-ops",
    "productName": "ARR Ops",
    "extraMetadata": {
      "cliCompanion": "arr-cli.exe"
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "type": "module"
}
